{
  "compilerOptions": {
    "target": "ES2021", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "skipLibCheck": true, "isolatedModules": true, "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "dev/**/*.ts"]
}
